# ==============================================================================
# КОНФИГУРАЦИЯ МИКРОСЕРВИСА LIBRARY-SVC (Каталог и хранилище документов МИЭМ)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ПОДКЛЮЧЕНИЕ К POSTGRESQL
# ------------------------------------------------------------------------------
# Основная строка подключения к базе данных библиотеки (SQLAlchemy + asyncpg).
# Обязательно должна начинаться с префикса: postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://my_user:my_secret_password@localhost:5432/library_db

# Дополнительные параметры (используются как fallback для автоматической сборки
# DATABASE_URL, если строка выше не задана, а также для контейнера db в docker-compose):
POSTGRES_USER=my_user
POSTGRES_PASSWORD=my_secret_password
POSTGRES_DB=library_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. ОБЪЕКТНОЕ ХРАНИЛИЩЕ MINIO / S3 (ХРАНЕНИЕ И СТРИМИНГ ФАЙЛОВ)
# ------------------------------------------------------------------------------
# Сетевой адрес сервера MinIO/S3 (в Docker: minio:9000, при локальном запуске: localhost:9000)
MINIO_ENDPOINT=localhost:9000

# Ключи доступа к MinIO/S3
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Имя бакета по умолчанию, где хранятся файлы документов
MINIO_BUCKET=documents

# Использовать ли защищенное HTTPS-соединение (false для локального MinIO, true для production S3)
MINIO_SECURE=false

# Предпросмотр Office-документов (конвертация через LibreOffice)
# Конвертация блокирующая и выполняется в пуле потоков; эти лимиты защищают сервис от
# зависшего LibreOffice, огромных файлов и слишком большого числа параллельных конвертаций.
PREVIEW_CONVERT_TIMEOUT_SEC=120
PREVIEW_MAX_SOURCE_BYTES=52428800
PREVIEW_MAX_CONCURRENCY=2
